# "mock" reads JSON from src/mocks. "api" calls the live backend (same API as the mobile app).
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL of the TGB backend API (server-side only)
API_BASE_URL=https://api.thegoodbiker.com

# Optional: CDN host that serves images coming from the API (added to next/image remotePatterns)
NEXT_PUBLIC_IMAGE_HOST=

# Shared secret the backend / admin panel sends to POST /api/revalidate
REVALIDATE_SECRET=change-me

# Public site URL (used for metadata, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags (true/false). Ship shop & membership independently.
NEXT_PUBLIC_FEATURE_SHOP=false
NEXT_PUBLIC_FEATURE_MEMBERSHIP=false
NEXT_PUBLIC_FEATURE_AUTH=false
